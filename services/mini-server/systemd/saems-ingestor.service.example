[Unit]
Description=SAEMS MQTT ingestor
After=network-online.target saems-mqtt.service
Wants=network-online.target saems-mqtt.service

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/saems-mini-server
EnvironmentFile=/home/admin/saems-mini-server/.env
ExecStart=/home/admin/saems-mini-server/.venv/bin/python /home/admin/saems-mini-server/mqtt_ingestor.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/admin/saems-mini-server/data

[Install]
WantedBy=multi-user.target
